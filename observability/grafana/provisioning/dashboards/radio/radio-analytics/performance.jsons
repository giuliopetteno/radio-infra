      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Status Breakdown",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "sum by (kpi, status) (\r\n  round(\r\n    increase(\r\n      analytics_kpi_duration_milliseconds_count{\r\n        mode=\"$mode\"\r\n      }[$__range]\r\n    )\r\n  )\r\n)\r\nor\r\nlabel_replace(\r\n  sum by (kpi) (\r\n    round(\r\n      increase(\r\n        analytics_kpi_duration_milliseconds_count{\r\n          mode=\"$mode\"\r\n        }[$__range]\r\n      )\r\n    )\r\n  ) * 0,\r\n  \"status\", \"FAILED\", \"\", \"\"\r\n)\r\nor\r\nlabel_replace(\r\n  sum by (kpi) (\r\n    round(\r\n      increase(\r\n        analytics_kpi_duration_milliseconds_count{\r\n          mode=\"$mode\"\r\n        }[$__range]\r\n      )\r\n    )\r\n  ) * 0,\r\n  \"status\", \"TIMEOUT\", \"\", \"\"\r\n)",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{kpi}} - {{status}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "groupingToMatrix",
                  "spec": {
                    "options": {
                      "columnField": "status",
                      "rowField": "kpi",
                      "valueField": "Value"
                    }
