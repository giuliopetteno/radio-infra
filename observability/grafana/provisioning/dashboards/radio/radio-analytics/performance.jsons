      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Performance",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "sort_desc(\r\n  sum by (kpi) (\r\n    analytics_kpi_duration_milliseconds_sum{\r\n      mode=\"$mode\"\r\n    }\r\n  )\r\n  /\r\n  sum by (kpi) (\r\n    analytics_kpi_duration_milliseconds_count{\r\n      mode=\"$mode\"\r\n    }\r\n  )\r\n)",
                        "instant": true,
                        "legendFormat": "{{kpi}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "13.1.1",
            "spec": {
              "options": {
                "displayMode": "basic",
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "overflow": "ellipsis",
                  "placement": "bottom",
                  "showLegend": false
                },
                "maxVizHeight": 300,
                "minVizHeight": 16,
                "minVizWidth": 8,
                "namePlacement": "auto",
                "orientation": "horizontal",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showUnfilled": true,
                "sizing": "auto",
                "valueMode": "color"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "decimals": 0,
                  "thresholds": {
                    "mode": "percentage",
                    "steps": [
                      {
                        "value": 0,
                        "color": "light-blue"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Duration Over Time",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (kpi) (\r\n  increase(\r\n    analytics_kpi_duration_milliseconds_sum{\r\n      mode=\"$mode\"\r\n    }[30m]\r\n  )\r\n)\r\n/\r\nsum by (kpi) (\r\n  increase(\r\n    analytics_kpi_duration_milliseconds_count{\r\n      mode=\"$mode\"\r\n    }[30m]\r\n  )\r\n)",
                        "legendFormat": "{{kpi}}",
                        "range": true
