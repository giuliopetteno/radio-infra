      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Outcomes",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "sum by (status) (\r\n  round(\r\n    increase(\r\n      analytics_kpi_duration_milliseconds_count{\r\n        mode=\"$mode\"\r\n      }[$__range]\r\n    )\r\n  )\r\n)\r\nor\r\nlabel_replace(vector(0), \"status\", \"SUCCESS\", \"\", \"\")\r\nor\r\nlabel_replace(vector(0), \"status\", \"FAILED\", \"\", \"\")\r\nor\r\nlabel_replace(vector(0), \"status\", \"TIMEOUT\", \"\", \"\")",
                        "instant": true,
                        "legendFormat": "{{status}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
