      "panel-19": {
        "kind": "Panel",
        "spec": {
          "id": 19,
          "title": "Snapshot",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "yesoreyeram-infinity-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "ffvklux9t6bcwe"
                      },
                      "spec": {
                        "columns": [
                          {
                            "selector": "dataset",
                            "text": "dataset",
                            "type": "string"
                          },
                          {
                            "selector": "label",
                            "text": "label",
                            "type": "string"
                          },
                          {
                            "selector": "value",
                            "text": "value",
                            "type": "number"
                          },
                          {
                            "selector": "time",
                            "text": "time",
                            "type": "string"
                          },
                          {
                            "selector": "status",
                            "text": "status",
                            "type": "string"
                          },
                          {
                            "selector": "generatedAt",
                            "text": "generatedAt",
                            "type": "timestamp"
                          }
                        ],
                        "filters": [],
                        "format": "table",
                        "global_query_id": "",
                        "parser": "backend",
                        "root_selector": "(\n  $root := $;\n  $k := $root.kpiResults;\n\n$meta := [\n{\n  \"dataset\": \"meta\",\n  \"generatedAt\": $root.generatedAt,\n  \"status\": $root.executionStatus\n}\n];\n  $base := [\n    {\n      \"dataset\": \"device_scalar\",\n      \"label\": \"total\",\n      \"value\": $k.deviceSummary.result.total\n    },\n    {\n      \"dataset\": \"device_scalar\",\n      \"label\": \"avg_age\",\n      \"value\": $k.averageDeviceAge.result\n    },\n\n    {\n      \"dataset\": \"device_status\",\n      \"label\": \"Active\",\n      \"value\": $k.deviceSummary.result.active\n    },\n\t{\n      \"dataset\": \"device_status\",\n      \"label\": \"Pending Installation\",\n      \"value\": $k.deviceSummary.result.pendingInstallation\n    },\n    {\n      \"dataset\": \"device_status\",\n      \"label\": \"Under Maintenance\",\n      \"value\": $k.deviceSummary.result.underMaintenance\n    },\n\t    {\n      \"dataset\": \"device_status\",\n      \"label\": \"Out of Service\",\n      \"value\": $k.deviceSummary.result.outOfService\n    },\n\t{\n      \"dataset\": \"device_status\",\n      \"label\": \"Pending Decommissioning\",\n      \"value\": $k.deviceSummary.result.pendingDecommissioning\n    },\n\t{\n      \"dataset\": \"device_status\",\n      \"label\": \"Decommissioned\",\n      \"value\": $k.deviceSummary.result.decommissioned\n    },\n    {\n      \"dataset\": \"device_status\",\n      \"label\": \"Deleted\",\n      \"value\": $k.deviceSummary.result.deleted\n    }\n  ];\n\n  $types := $map(\n    $k.devicesByType.result,\n    function($v) {\n      {\n        \"dataset\": \"device_type\",\n        \"label\": $v.deviceTypeName,\n        \"value\": $v.total\n      }\n    }\n  );\n\n  $organizations := $map(\n    $k.devicesByOrganization.result,\n    function($v) {\n      {\n        \"dataset\": \"organization\",\n        \"label\": $v.organizationName,\n        \"value\": $v.total\n      }\n    }\n  );\n\n  $departments := $map(\n    $k.devicesByDepartment.result,\n    function($v) {\n      {\n        \"dataset\": \"department\",\n        \"label\": $v.departmentName,\n        \"value\": $v.total\n      }\n    }\n  );\n\n  $organizationSummary := [\n    {\n      \"dataset\": \"organization_summary\",\n      \"label\": \"total\",\n      \"value\": $k.organizationSummary.result.total\n    },\n    {\n      \"dataset\": \"organization_summary\",\n      \"label\": \"with_devices\",\n      \"value\": $k.organizationSummary.result.withDevices\n    },\n    {\n      \"dataset\": \"organization_summary\",\n      \"label\": \"without_devices\",\n      \"value\": $k.organizationSummary.result.withoutDevices\n    },\n    {\n      \"dataset\": \"organization_summary\",\n      \"label\": \"deleted\",\n      \"value\": $k.organizationSummary.result.deleted\n    }\n  ];\n\n  $departmentSummary := [\n    {\n      \"dataset\": \"department_summary\",\n      \"label\": \"total\",\n      \"value\": $k.departmentSummary.result.total\n    },\n    {\n      \"dataset\": \"department_summary\",\n      \"label\": \"with_devices\",\n      \"value\": $k.departmentSummary.result.withDevices\n    },\n    {\n      \"dataset\": \"department_summary\",\n      \"label\": \"without_devices\",\n      \"value\": $k.departmentSummary.result.withoutDevices\n    },\n    {\n      \"dataset\": \"department_summary\",\n      \"label\": \"deleted\",\n      \"value\": $k.departmentSummary.result.deleted\n    }\n  ];\n\n  $deviceTypeSummary := [\n    {\n      \"dataset\": \"device_type_summary\",\n      \"label\": \"total\",\n      \"value\": $k.deviceTypeSummary.result.total\n    },\n    {\n      \"dataset\": \"device_type_summary\",\n      \"label\": \"with_devices\",\n      \"value\": $k.deviceTypeSummary.result.withDevices\n    },\n    {\n      \"dataset\": \"device_type_summary\",\n      \"label\": \"without_devices\",\n      \"value\": $k.deviceTypeSummary.result.withoutDevices\n    },\n    {\n      \"dataset\": \"device_type_summary\",\n      \"label\": \"deleted\",\n      \"value\": $k.deviceTypeSummary.result.deleted\n    }\n  ];\n\n  $installations := $map(\n    $k.devicesInstallationTrend.result,\n    function($v) {\n      {\n        \"dataset\": \"installation_trend\",\n        \"label\": \"installations\",\n        \"value\": $v.total,\n        \"time\":\n          $string($v.year) & \"-\" &\n          ($v.month < 10\n            ? \"0\" & $string($v.month)\n            : $string($v.month)\n          ) &\n          \"-01\"\n      }\n    }\n  );\n\n  $decommissioning := $map(\n    $k.devicesDecommissioningTrend.result,\n    function($v) {\n      {\n        \"dataset\": \"decommissioning_trend\",\n        \"label\": \"decommissioning\",\n        \"value\": $v.total,\n        \"time\":\n          $string($v.year) & \"-\" &\n          ($v.month < 10\n            ? \"0\" & $string($v.month)\n            : $string($v.month)\n          ) &\n          \"-01\"\n      }\n    }\n  );\n\n  $deviceEvents := $map(\n    $k.deviceEventsTrend.result,\n    function($v) {\n      {\n        \"dataset\": \"device_events_trend\",\n        \"label\": $v.eventType,\n        \"value\": $v.total,\n        \"time\":\n          $string($v.year) & \"-\" &\n          ($v.month < 10\n            ? \"0\" & $string($v.month)\n            : $string($v.month)\n          ) &\n          \"-01\"\n      }\n    }\n  );\n\n  $organizationEvents := $map(\n    $k.organizationEventsTrend.result,\n    function($v) {\n      {\n        \"dataset\": \"organization_events_trend\",\n        \"label\": $v.eventType,\n        \"value\": $v.total,\n        \"time\":\n          $string($v.year) & \"-\" &\n          ($v.month < 10\n            ? \"0\" & $string($v.month)\n            : $string($v.month)\n          ) &\n          \"-01\"\n      }\n    }\n  );\n\n  $departmentEvents := $map(\n    $k.departmentEventsTrend.result,\n    function($v) {\n      {\n        \"dataset\": \"department_events_trend\",\n        \"label\": $v.eventType,\n        \"value\": $v.total,\n        \"time\":\n          $string($v.year) & \"-\" &\n          ($v.month < 10\n            ? \"0\" & $string($v.month)\n            : $string($v.month)\n          ) &\n          \"-01\"\n      }\n    }\n  );\n\n  $deviceTypeEvents := $map(\n    $k.deviceTypeEventsTrend.result,\n    function($v) {\n      {\n        \"dataset\": \"device_type_events_trend\",\n        \"label\": $v.eventType,\n        \"value\": $v.total,\n        \"time\":\n          $string($v.year) & \"-\" &\n          ($v.month < 10\n            ? \"0\" & $string($v.month)\n            : $string($v.month)\n          ) &\n          \"-01\"\n      }\n    }\n  );\n\n  $append(\n    $append(\n      $append(\n        $append(\n          $append(\n            $append(\n              $append(\n                $append(\n                  $append(\n                    $append(\n                      $append(\n                        $append(\n                          $meta,\n                          $base\n                        ),\n                        $types\n                      ),\n                      $organizations\n                    ),\n                    $departments\n                  ),\n                  $organizationSummary\n                ),\n                $departmentSummary\n              ),\n              $deviceTypeSummary\n            ),\n            $installations\n          ),\n          $decommissioning\n        ),\n        $deviceEvents\n      ),\n      $organizationEvents\n    ),\n    $append(\n      $departmentEvents,\n      $deviceTypeEvents\n    )\n  )\n)",
                        "source": "url",
                        "type": "json",
                        "url": "http://radio-analytics:8081/api/v1/analytics/${mode}",
                        "url_options": {
                          "data": "",
                          "method": "GET"
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "filterByValue",
                  "spec": {
                    "options": {
                      "filters": [
                        {
                          "config": {
                            "id": "equal",
                            "options": {
                              "value": "meta"
                            }
                          },
                          "fieldName": "dataset"
                        }
                      ],
                      "match": "all",
                      "type": "include"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "dataset": true,
                        "label": true,
                        "status": false,
                        "time": true,
                        "value": true
                      },
                      "includeByName": {},
                      "indexByName": {},
                      "renameByName": {
                        "generatedAt": "Generated At",
                        "status": "Status"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.1.1",
            "spec": {
              "options": {
                "cellHeight": "sm",
