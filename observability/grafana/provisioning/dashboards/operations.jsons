      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Requests counter",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "topk(\r\n  20,\r\n  sum by (uri, method) (\r\n    http_server_requests_milliseconds_count{\r\n      application=\"radio-registry\",\r\n      uri!~\"/swagger-ui.*|/v3/api-docs.*|/actuator.*\",\r\n      uri!=\"UNKNOWN\"\r\n    }\r\n  )\r\n)",
                        "format": "time_series",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "timeFrom": "30d"
              }
            }
          },
