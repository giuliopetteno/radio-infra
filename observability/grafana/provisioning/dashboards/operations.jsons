                "minVizHeight": 16,
                "minVizWidth": 8,
                "namePlacement": "top",
                "orientation": "horizontal",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showUnfilled": true,
                "sizing": "auto",
                "text": {
                  "valueSize": 12
                },
                "valueMode": "color"
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "percentage",
                    "steps": [
                      {
                        "value": 0,
